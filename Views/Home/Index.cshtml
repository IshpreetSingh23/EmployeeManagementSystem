@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">

    <div class="card shadow p-5">

        <h1 class="text-center text-primary">
            Employee Management System
        </h1>

        <hr />

        <h3 class="text-success">
            Login Successful
        </h3>

        <p class="lead">
            Welcome to the Admin Dashboard.
        </p>

        <div class="row mt-4">

            <!-- Employees -->
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <h4>Employees</h4>
                        <h2>@ViewBag.EmployeeCount</h2>
                    </div>
                </div>
            </div>

            <!-- Departments -->
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body text-center">
                        <h4>Departments</h4>
                        <h2>@ViewBag.DepartmentCount</h2>
                    </div>
                </div>
            </div>

            <!-- Present -->
            <div class="col-md-3">
                <div class="card bg-warning text-dark">
                    <div class="card-body text-center">
                        <h4>Present</h4>
                        <h2>@ViewBag.PresentCount</h2>
                    </div>
                </div>
            </div>

            <!-- Absent -->
            <div class="col-md-3">
                <div class="card bg-danger text-white">
                    <div class="card-body text-center">
                        <h4>Absent</h4>
                        <h2>@ViewBag.AbsentCount</h2>
                    </div>
                </div>
            </div>

        </div>

        <hr />

        <div class="mt-4">

            <a asp-controller="Employee"
               asp-action="Add"
               class="btn btn-primary">
                Add Employee
            </a>

            <a asp-controller="Employee"
               asp-action="Index"
               class="btn btn-success">
                View Employees
            </a>

            <a asp-controller="Attendance"
               asp-action="Index"
               class="btn btn-warning">
                Attendance
            </a>

            <a asp-controller="Department"
               asp-action="Index"
               class="btn btn-info">
                Departments
            </a>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-danger">
                Logout
            </a>

        </div>

    </div>

</div>